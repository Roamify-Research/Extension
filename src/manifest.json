{
  "manifest_version": 3,
  "name": "ROAMIFY",
  "description": "An extension to get HTML content of all open tabs and display a sidebar.",
  "version": "1.3.0",
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Open ROAMIFY"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://traveltriangle.com/*",
    "https://makemytrip.com/*",
    "http://192.168.3.177/*",
    "https://roamify.fakepickle.tech/*"
  ]
}